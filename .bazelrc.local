# Disable SSL verification for downloads (workaround for certificate issues)
common --repo_env=JAVA_TOOL_OPTIONS="-Djavax.net.ssl.trustStore=/etc/ssl/certs/adoptium/cacerts -Djavax.net.ssl.trustStorePassword=changeit"

# Override rules_python with local copy to avoid SSL download issues
common --override_repository=rules_python=/tmp/bazel_deps/rules_python-0.24.0
